{
  "name": "designos/renderer-blade",
  "description": "Server-side Blade renderer for DesignOS PageDocument data.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^13.0",
    "illuminate/view": "^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "DesignOS\\RendererBlade\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DesignOS\\RendererBlade\\RendererBladeServiceProvider"
      ]
    }
  }
}
